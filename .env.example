# Copy to .env for local development.
TMCP_RESOURCE_URL=http://localhost:8000/mcp
TMCP_ISSUER_URL=http://localhost:9000
# Local only: static bearer token accepted on /mcp. Never set in production.
TMCP_DEV_TOKEN=change-me-local-only
TMCP_DATABASE_URL=postgresql+psycopg://training:training@db:5432/training
# Garmin Connect Personal API key: Garmin Connect > Settings > Personal API Token.
# Optional; when empty the Garmin tools are not exposed. Keep the real value only in .env.
GARMIN_PERSONAL_API_KEY=
